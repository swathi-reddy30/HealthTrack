# Copy this file to .env and adjust as needed. Every setting is optional:
# the defaults below are used when a value is not set. Never commit .env.

# Path to the trained model file (relative paths start at the project root).
MODEL_PATH=models/healthtrack_model.joblib

# Folder for the rotating log file, and the log level (DEBUG shows cache hits/misses per patient).
LOG_DIR=logs
LOG_LEVEL=INFO

# Maximum CSV upload size in bytes (2 MB).
MAX_UPLOAD_BYTES=2097152

# Prediction cache: maximum number of entries and time-to-live in seconds.
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=3600
